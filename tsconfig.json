{
  // Standalone package tsconfig. Deliberately does NOT extend
  // ../../tsconfig.base.json: that facade maps every @deepseek-ai/dsh-* name
  // to workspace SOURCE (.tsx / CSS / cross-package remote chains), which only
  // compiles under the repo's per-package project-reference boundaries. This
  // package instead resolves the client-side framework imports to the built
  // .d.ts artifacts of the @deepseek-ai packages installed into the project's
  // own node_modules (see devDependencies in package.json). Every path below is
  // relative to this file, so the config carries no developer machine paths.
  // skipLibCheck then skips their internals while the package's own code stays
  // checked.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "declaration": false,
    "noEmit": true,
    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "paths": {
      "@deepseek-ai/cordis": ["./node_modules/@deepseek-ai/cordis/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-tools": ["./node_modules/@deepseek-ai/dsh-tools/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-host-webserver": ["./node_modules/@deepseek-ai/dsh-host-webserver/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-llm": ["./node_modules/@deepseek-ai/dsh-llm/lib/types/index.d.ts"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"],
      "@deepseek-ai/dsh-client-ui-slots": ["./node_modules/@deepseek-ai/dsh-client-ui-slots/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-renderer": ["./node_modules/@deepseek-ai/dsh-client-ui-renderer/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-renderer/client": ["./node_modules/@deepseek-ai/dsh-client-ui-renderer/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-settings": ["./node_modules/@deepseek-ai/dsh-client-ui-settings/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-settings/client": ["./node_modules/@deepseek-ai/dsh-client-ui-settings/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-locale": ["./node_modules/@deepseek-ai/dsh-client-locale/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-client-locale/client": ["./node_modules/@deepseek-ai/dsh-client-locale/lib/types/client/index.d.ts"]
    }
  },
  "include": ["src", "tsdown.config.ts"]
}
